# Copy this file to .env at the repo root (server/src/config.ts loads it from there)
# and fill in real values. Never commit the real .env.

# ─── Core ───
PORT=3000
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Yooz-Manage (/manage) owner/member seed accounts ───
MANAGE_OWNER_EMAIL=
MANAGE_OWNER_PASSWORD=
MANAGE_OWNER_NAME=
MANAGE_MEMBER_EMAIL=
MANAGE_MEMBER_PASSWORD=
MANAGE_MEMBER_NAME=

# ─── Cloudinary (media storage) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Gemini AI ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── Azure Speech (text-to-speech) ───
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ─── TextMe (SMS provider) ───
TEXTME_API_TOKEN=
TEXTME_USERNAME=
TEXTME_SOURCE=Yooz

# ─── Resend (transactional email) ───
RESEND_API_KEY=

# ─── Misc ───
# Shared secret for the public register-phone API (till/POS integration). Unset = endpoint refuses all calls.
REGISTER_PHONE_KEY=
# Public site URL used to build absolute links (SMS reward links, etc). Falls back to the request host.
APP_URL=
# Facebook app id, used by the client for FB login/share.
FACEBOOK_APP_ID=
