{
  "name": "yooz",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "typecheck": "npm run typecheck --prefix server && npm run typecheck --prefix client",
    "test": "tsx --test \"client/src/**/*.test.ts\" \"server/src/**/*.test.ts\"",
    "guidelines": "node scripts/guidelines.mjs",
    "check": "npm run typecheck && npm test && npm run guidelines",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build:client && npm start",
    "walkthrough": "npx playwright test --project=walkthroughs && npm run walkthrough:voice",
    "walkthrough:record": "npx playwright test --project=walkthroughs",
    "walkthrough:voice": "npm run walkthrough:voice:login && npm run walkthrough:voice:create && npm run walkthrough:voice:library",
    "walkthrough:voice:login": "npx tsx walkthroughs/add-voice.ts walkthrough-videos/01-admin-login-Admin-Login-Walkthrough-walkthroughs/video.webm walkthrough-videos/01-admin-login-narration.json walkthrough-videos/admin-login-narrated.mp4",
    "walkthrough:voice:create": "npx tsx walkthroughs/add-voice.ts walkthrough-videos/02-create-activity-Create-Activity-Walkthrough-walkthroughs/video.webm walkthrough-videos/02-create-activity-narration.json walkthrough-videos/create-activity-narrated.mp4",
    "walkthrough:voice:library": "npx tsx walkthroughs/add-voice.ts walkthrough-videos/03-export-from-library-Export-From-Library-Walkthrough-walkthroughs/video.webm walkthrough-videos/03-export-library-narration.json walkthrough-videos/export-library-narrated.mp4"
  },
  "dependencies": {
    "firebase-admin": "^13.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.12.0",
    "say": "^0.16.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.70.1"
  }
}
